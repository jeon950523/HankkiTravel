# 모든 실제 값은 로컬 .env 또는 배포 플랫폼의 Secret/Environment Variable에만 설정합니다.
# 이 파일에는 실제 키, 비밀번호, 토큰을 절대 저장하지 않습니다.

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8300
VITE_KAKAO_JAVASCRIPT_KEY=

# Backend / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hankki_travel
DB_USERNAME=
DB_PASSWORD=

# 외부 연동
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
WEB_BASE_URL=http://localhost:5173

# 운영 제어 — 로컬에서는 관리자 동기화를 기본 비활성화합니다.
ADMIN_SYNC_ENABLED=false
ADMIN_SYNC_USERNAME=
ADMIN_SYNC_PASSWORD=
TOURISM_SYNC_DAILY_CALL_BUDGET=0
TOURISM_SYNC_OPERATION_ZONE=Asia/Seoul
